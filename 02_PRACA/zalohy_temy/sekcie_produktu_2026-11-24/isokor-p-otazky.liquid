{%- comment -%} Isokor – otázky a odpovede (metapole isokor.faq). Bez otázok sa nezobrazí. {%- endcomment -%}
{%- assign faq = product.metafields.isokor.faq.value -%}
{%- if faq != blank and faq.size > 0 -%}
<section class="isk-pi isk-pi--lin">
  <div class="isk-pi__wrap">
    <div class="isk-faq">
      <h2>{{ section.settings.heading }}</h2>
      {%- for q in faq -%}
        <details><summary>{{ q.q }}</summary><p>{{ q.a }}</p></details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Isokor – otázky",
  "tag": "div",
  "class": "isk-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Otázky sa berú z poľa produktu „Isokor – FAQ“. Bez otázok sa sekcia skryje." },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Spørsmål og svar" }
  ],
  "presets": [{ "name": "Isokor – otázky" }]
}
{% endschema %}
