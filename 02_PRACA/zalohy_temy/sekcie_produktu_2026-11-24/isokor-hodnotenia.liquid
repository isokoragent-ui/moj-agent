{%- comment -%}
  Isokor – hodnotenia (Fera). Prázdne miesto, kam Fera vloží widget s hodnoteniami
  (vo Fere nastavené umiestnenie „CSS Selector“ → #isk-fera-anm-{{ template.name }}).
  Sekciu môžeš v editore posúvať kamkoľvek; widget sa presunie s ňou.
{%- endcomment -%}
<div class="isk-anm page-width">
  <div id="isk-fera-anm-{{ template.name }}" class="isk-anm__box"></div>
</div>
<style>
  .isk-anm { padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px; }
  .isk-anm__box { max-width: {{ section.settings.max_w }}px; margin: 0 auto; }
</style>

{% schema %}
{
  "name": "Isokor – hodnotenia",
  "tag": "div",
  "class": "isk-section",
  "settings": [
    { "type": "paragraph", "content": "Sem vloží Fera hodnotenia. Sekciu posuň tam, kde ich chceš mať. Vzhľad hodnotení (počet, nadpis) sa nastavuje vo Fere." },
    { "type": "range", "id": "max_w", "label": "Max. šírka (px)", "min": 500, "max": 1400, "step": 20, "default": 900 },
    { "type": "range", "id": "pad_top", "label": "Odsadenie hore", "min": 0, "max": 80, "step": 4, "default": 24 },
    { "type": "range", "id": "pad_bottom", "label": "Odsadenie dole", "min": 0, "max": 80, "step": 4, "default": 36 }
  ],
  "presets": [{ "name": "Isokor – hodnotenia" }]
}
{% endschema %}
