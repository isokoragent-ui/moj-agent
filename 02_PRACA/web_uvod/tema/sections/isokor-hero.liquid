{{ 'isokor-forside.css' | asset_url | stylesheet_tag }}
<section class="isk isk-hero" id="isk-hero-{{ section.id }}">
  <div class="isk__wrap">
    <div class="isk-hero__text">
      {%- if section.settings.eyebrow != blank -%}<p class="isk__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="isk__h1">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="isk__lead">{{ section.settings.text }}</p>{%- endif -%}
      <div class="isk__btns">
        {%- if section.settings.btn1_label != blank -%}<a class="isk__btn isk__btn--fill" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1_label }}</a>{%- endif -%}
        {%- if section.settings.btn2_label != blank -%}<a class="isk__btn isk__btn--line" href="{{ section.settings.btn2_link | default: '#isk-problemer' }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
      </div>
      <ul class="isk-hero__trust">
        {%- assign trusts = section.settings.trust1 | append: '|' | append: section.settings.trust2 | append: '|' | append: section.settings.trust3 | split: '|' -%}
        {%- for t in trusts -%}
          {%- if t != blank -%}
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1f4d36" stroke-width="2.4" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>{{ t }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
    <div class="isk-hero__media">
      <svg class="isk-hero__deco" viewBox="0 0 600 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g fill="none" stroke="#c9d8c4" stroke-width="2"><path d="M470 40l60 35v70l-60 35-60-35V75z"/><path d="M90 330l50 29v58l-50 29-50-29v-58z"/><path d="M540 360l36 21v42l-36 21-36-21v-42z"/></g></svg>
      {%- if section.settings.price_text != blank -%}
        <div class="isk-hero__chip"><small>{{ section.settings.price_small }}</small><span>{{ section.settings.price_text }}</span></div>
      {%- endif -%}
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.image.alt }}
      {%- else -%}
        <div class="isk-hero__trio">
          {%- for p in section.settings.products -%}
            {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 500 | image_tag: loading: 'eager', alt: p.title }}{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Isokor – Hero",
  "tag": "div",
  "class": "isk-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis nad", "default": "Miljøvennlig rengjøring · Agder" },
    { "type": "text", "id": "heading", "label": "Hlavný nadpis", "default": "Rent hjem. Ren samvittighet." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Rengjøring og nano-impregnering som tar kalk, fett, rust og mugg – skånsomt mot deg, huset og naturen." },
    { "type": "text", "id": "btn1_label", "label": "Tlačidlo 1 – text", "default": "Se alle produkter" },
    { "type": "url", "id": "btn1_link", "label": "Tlačidlo 1 – odkaz" },
    { "type": "text", "id": "btn2_label", "label": "Tlačidlo 2 – text", "default": "Finn riktig middel" },
    { "type": "url", "id": "btn2_link", "label": "Tlačidlo 2 – odkaz (prázdne = skok na „Hva vil du bli kvitt?“)" },
    { "type": "text", "id": "trust1", "label": "Výhoda 1", "default": "Betal med Vipps" },
    { "type": "text", "id": "trust2", "label": "Výhoda 2", "default": "Rask levering i hele Norge" },
    { "type": "text", "id": "trust3", "label": "Výhoda 3", "default": "Lokal kundeservice" },
    { "type": "header", "content": "Obrázok vpravo" },
    { "type": "image_picker", "id": "image", "label": "Obrázok (fľaše bez pozadia, PNG)", "info": "Keď je prázdne, ukážu sa fotky 3 produktov nižšie." },
    { "type": "product_list", "id": "products", "label": "Produkty (keď nie je obrázok)", "limit": 3 },
    { "type": "text", "id": "price_small", "label": "Štítok – malý text", "default": "Spray på 500 ml" },
    { "type": "text", "id": "price_text", "label": "Štítok – cena", "default": "fra 149 kr" }
  ],
  "presets": [{ "name": "Isokor – Hero" }]
}
{% endschema %}
