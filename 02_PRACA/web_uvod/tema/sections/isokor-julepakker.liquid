{{ 'isokor-forside.css' | asset_url | stylesheet_tag }}
<section class="isk isk-jp" id="isk-julepakker">
  <div class="isk-snow" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  {%- render 'isokor-snoflak', size: 180, style: 'right: -4rem; top: -3rem' -%}
  {%- render 'isokor-snoflak', size: 90, style: 'left: 2rem; bottom: 4rem' -%}
  <div class="isk__wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="isk__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="isk__h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="isk-jp__sub">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.frist != blank -%}<span class="isk-jp__frist">{{ section.settings.frist }}</span>{%- endif -%}
    <div class="isk-jp__grid">
      {%- for block in section.blocks -%}
        {%- assign pk = block.settings.product -%}
        {%- if pk != blank -%}
          {%- assign a = block.settings.product_a -%}
          {%- assign b = block.settings.product_b -%}
          {%- assign v = pk.selected_or_first_available_variant -%}
          <article class="isk-jp__card" {{ block.shopify_attributes }}>
            {%- if block.settings.ribbon != blank -%}<span class="isk-jp__ribbon">{{ block.settings.ribbon }}</span>{%- endif -%}
            <a class="isk-jp__media" href="{{ pk.url }}" style="background: {{ block.settings.bg }}" aria-label="{{ pk.title | escape }}">
              <svg class="isk-jp__branch" viewBox="0 0 160 120" aria-hidden="true"><g stroke="#2f6b4c" stroke-width="3" stroke-linecap="round" fill="none"><path d="M4 8 C50 30 90 60 150 110"/><path d="M30 22l-10 18M30 22l16-12M55 38l-10 20M55 38l18-10M80 56l-8 20M80 56l18-8M105 76l-6 20M105 76l18-6M128 94l-4 16M128 94l16-4"/></g><circle cx="44" cy="44" r="6" fill="{{ block.settings.berry }}"/><circle cx="54" cy="52" r="5" fill="{{ block.settings.berry }}"/><circle cx="96" cy="84" r="6" fill="{{ block.settings.berry }}"/></svg>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', alt: pk.title }}
              {%- else -%}
                <span class="isk-jp__pair">
                  {%- if a.featured_image -%}{{ a.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: a.title }}{%- endif -%}
                  {%- if b.featured_image -%}{{ b.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: b.title }}{%- endif -%}
                </span>
              {%- endif -%}
            </a>
            <div class="isk-jp__body">
              {%- if block.settings.kicker != blank -%}<span class="isk-jp__kicker">{{ block.settings.kicker }}</span>{%- endif -%}
              <h3 class="isk-jp__title">{{ block.settings.title | default: pk.title }}</h3>
              <ul class="isk-jp__list">
                {%- if a != blank -%}<li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1f4d36" stroke-width="2.6" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg><span><a href="{{ a.url }}">{{ block.settings.a_name | default: a.title }}</a> – {{ block.settings.a_text }}</span></li>{%- endif -%}
                {%- if b != blank -%}<li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1f4d36" stroke-width="2.6" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg><span><a href="{{ b.url }}">{{ block.settings.b_name | default: b.title }}</a> – {{ block.settings.b_text }}</span></li>{%- endif -%}
              </ul>
              <div class="isk-jp__price">
                <strong>{{ pk.price | money_without_trailing_zeros }}</strong>
                <em>{{ block.settings.price_note }}</em>
                {%- if a != blank and b != blank -%}
                  {%- assign hver = a.price | plus: b.price | plus: section.settings.frakt_ore -%}
                  {%- assign spar = hver | minus: pk.price -%}
                  {%- if spar > 0 -%}<span class="isk-jp__spar">{{ section.settings.spar_label }} {{ spar | money_without_trailing_zeros }}</span>{%- endif -%}
                {%- endif -%}
              </div>
              <div class="isk-jp__btns">
                {%- if pk.available -%}
                  <form method="post" action="{{ routes.cart_add_url }}">
                    <input type="hidden" name="id" value="{{ v.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" class="isk__btn {% if block.settings.red %}isk__btn--red{% else %}isk__btn--gran{% endif %}">{{ section.settings.add_label }}</button>
                  </form>
                {%- else -%}
                  <span class="isk__btn isk__btn--line" aria-disabled="true">{{ section.settings.soldout_label }}</span>
                {%- endif -%}
                <a class="isk__btn isk__btn--line" href="{{ pk.url }}">{{ section.settings.more_label }}</a>
              </div>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Isokor – Julepakker",
  "tag": "div",
  "class": "isk-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis", "default": "Julepakkene 2026" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Bad og kjøkken klare til jul" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "To flasker som tar julevasken, frakt inkludert. Til deg selv – eller som en praktisk gave." },
    { "type": "text", "id": "frist", "label": "Termín objednávky pred Vianocami", "info": "Napr. „Bestill innen 16. desember – levert før jul“. Prázdne = neukáže sa. Over termín u PostNord/Bring." },
    { "type": "number", "id": "frakt_ore", "label": "Doprava pri kúpe zvlášť (v ørene, 9900 = 99 kr)", "default": 9900 },
    { "type": "text", "id": "spar_label", "label": "Text úspory", "default": "Du sparer" },
    { "type": "text", "id": "add_label", "label": "Tlačidlo košík", "default": "Legg i kurven" },
    { "type": "text", "id": "more_label", "label": "Tlačidlo viac", "default": "Les mer" },
    { "type": "text", "id": "soldout_label", "label": "Vypredané", "default": "Utsolgt" }
  ],
  "blocks": [
    {
      "type": "pakke",
      "name": "Balíček",
      "settings": [
        { "type": "product", "id": "product", "label": "Balíček (produkt)" },
        { "type": "text", "id": "title", "label": "Nadpis (inak názov produktu)" },
        { "type": "text", "id": "kicker", "label": "Malý nadpis", "default": "Badet" },
        { "type": "text", "id": "ribbon", "label": "Stuha v rohu", "default": "Julepris" },
        { "type": "image_picker", "id": "image", "label": "Obrázok (inak fotky 2 produktov)" },
        { "type": "color", "id": "bg", "label": "Pozadie obrázka", "default": "#e3ecf4" },
        { "type": "color", "id": "berry", "label": "Farba bobúľ", "default": "#a8202f" },
        { "type": "checkbox", "id": "red", "label": "Červené tlačidlo", "default": false },
        { "type": "product", "id": "product_a", "label": "Fľaša 1" },
        { "type": "text", "id": "a_name", "label": "Fľaša 1 – krátky názov" },
        { "type": "text", "id": "a_text", "label": "Fľaša 1 – na čo" },
        { "type": "product", "id": "product_b", "label": "Fľaša 2" },
        { "type": "text", "id": "b_name", "label": "Fľaša 2 – krátky názov" },
        { "type": "text", "id": "b_text", "label": "Fľaša 2 – na čo" },
        { "type": "text", "id": "price_note", "label": "Pri cene", "default": "for begge · frakt inkludert" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Isokor – Julepakker" }]
}
{% endschema %}
